              "raw": "{\n  \"dispositivoId\": 1,\n  \"temperatura\": 28.5,\n  \"pressao\": 1013.2,\n  \"umidade\": 60.0,\n  \"sensor_presenca\": false,\n  \"trava_seguranca\": false\n}"
